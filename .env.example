# =============================================================================
# Loan Management System — Frontend (.env.example)
#   cp .env.example .env && npm run dev   →  http://127.0.0.1:5174
# VITE_* values are public and baked in at build time: never put secrets here.
# =============================================================================

VITE_SITE_NAME="Loan Management System"
VITE_SITE_SHORT_NAME="LMS"
VITE_META_DESC="Loan Management System"

# API base, including the version. Must end with /api/v1.
#   Local (Vite proxy): /api/v1
#   Production:         https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Local Vite dev proxy target for /api and /storage (the Laravel backend). Ignored in builds.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# api = real backend login. demo = offline UI login (admin@lms.local / password); never in production.
VITE_AUTH_MODE=api

VITE_IDLE_TIMEOUT_MINUTES=30

# Theme
VITE_DARK_MODE=false
VITE_PRIMARY_COLOR=#0f766e
VITE_SECONDARY_COLOR=#64748b
VITE_SUCCESS_COLOR=#059669
VITE_INFO_COLOR=#1a6aa3
VITE_WARNING_COLOR=#d97706
VITE_DANGER_COLOR=#dc2626

VITE_MOBILE_BREAKPOINT_SIZE=768
VITE_ASIDE_MINIMIZE_BREAKPOINT_SIZE=1200
VITE_ASIDE_WIDTH_PX=272
VITE_SPACER_PX=16
